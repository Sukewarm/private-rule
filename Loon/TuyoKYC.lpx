[Script]
http-response ^https:\/\/withpersona\.com\/api\/internal\/verify\/v1\/inquiries(?:\?.*)?$ script-path=https://raw.githubusercontent.com/Sukewarm/private-rule/main/Loon/TuyoKYC.js,requires-body=true,max-size=0,timeout=10,tag=Tuyo KYC,enable=true

[MITM]
hostname = withpersona.com
