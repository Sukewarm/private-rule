#!name=club vowifi
#!desc=Club SIM / csl Wi-Fi Calling 规则；每条规则显式指向 PROXY，方便在 Loon 插件中映射/选择香港节点或香港策略组。
#!author=ChatGPT
#!homepage=https://www.clubsim.com.hk/

[Rule]
# Club SIM / csl eSIM & ODC
DOMAIN,csl.prod.ondemandconnectivity.com,PROXY
DOMAIN,hhk.prod.ondemandconnectivity.com,PROXY
DOMAIN-SUFFIX,csl.prod.ondemandconnectivity.com,PROXY
DOMAIN-SUFFIX,hhk.prod.ondemandconnectivity.com,PROXY

# Club SIM / csl VoWiFi ePDG, MCC 454 / MNC 000
DOMAIN,epdg.epc.mnc000.mcc454.pub.3gppnetwork.org,PROXY
DOMAIN,ss.epdg.epc.mnc000.mcc454.pub.3gppnetwork.org,PROXY
DOMAIN,ss.epdg.epc.geo.mnc000.mcc454.pub.3gppnetwork.org,PROXY
DOMAIN-SUFFIX,mnc000.mcc454.pub.3gppnetwork.org,PROXY

# iOS Wi-Fi Calling / Apple location check, required by many iPhone DPs
DOMAIN,gspe1-ssl.ls.apple.com,PROXY
