#!name=Napi SSR
#!desc=按原 Napi 资源入口思路制作：脚本 URL 本身也参与匹配；插件页可点 openUrl 导入节点订阅。更新订阅时必须保持插件开启。
#!author=Sukewarm
#!homepage=https://github.com/Sukewarm/private-rule
#!openUrl=loon://import?nodelist=https%3A%2F%2Fnapi.ltd%2FNapiSSR
#!date=2026-05-10

# 说明：
# 1. 原链接 https://napi.ltd/script/Worker/NapiSSR.js 不是普通浏览器可读 JS。
# 2. 它在 Loon 里应当作为“插件/重写资源入口”引用，而不是只当作普通 script-path。
# 3. 因此这里同时保留两个入口：
#    - 脚本资源入口：/script/Worker/NapiSSR.js
#    - 节点订阅入口：/NapiSSR
# 4. 插件页可点 openUrl，或者手动添加节点订阅：
#    https://napi.ltd/NapiSSR
# 5. 若 Loon 日志出现 Unexpected token '<'，说明拿到的仍是 404 HTML，不是真正脚本/插件资源。
#
# 风险提醒：免费 SSR 节点不建议用于银行、交易所、邮箱、Apple ID 等重要账号。

[URL Rewrite]
# 保留脚本 URL 本身的匹配入口；原 Napi 资源就是围绕这个 URL 做解析/重写的。
^https?:\/\/napi\.ltd\/script\/Worker\/NapiSSR\.js.*$ https://napi.ltd/script/Worker/NapiSSR.js 302

[Script]
# 脚本资源入口：保留对 NapiSSR.js 本身的匹配，避免漏掉原脚本针对自身 URL 的逻辑。
http-request ^https?:\/\/napi\.ltd\/script\/Worker\/NapiSSR\.js.*$ script-path=https://napi.ltd/script/Worker/NapiSSR.js,tag=NapiSSR脚本入口,timeout=30,enable=true

# 节点订阅入口：添加 / 更新 https://napi.ltd/NapiSSR 时由脚本在本地生成节点数据。
http-request ^https?:\/\/napi\.ltd\/NapiSSR.*$ script-path=https://napi.ltd/script/Worker/NapiSSR.js,tag=@点击添加节点订阅,timeout=30,enable=true

[MITM]
hostname = napi.ltd
